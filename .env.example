# Configuración del Proveedor de IA
# Para usar Ollama local (por defecto):
# AI_PROVIDER=ollama
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Para activar Google Gemini API directamente (cambiar AI_PROVIDER a gemini y poner la API key):
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=300
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300

GEMINI_API_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Servicios locales opcionales para materiales multimodales
# Piper/Kokoro HTTP TTS. Si no esta configurado, Gemma genera solo el guion.
PIPER_BASE_URL=http://piper:5000
PIPER_TTS_URL=http://piper:5000/synthesize
PIPER_VOICE=es_ES-sharvard-medium

# Render Mermaid/Markmap. Si no esta configurado, se devuelve el codigo Mermaid.
MERMAID_RENDER_URL=http://ai-service:8001/render/mermaid

# FLUX/ComfyUI. Si no esta configurado, Gemma genera solo el prompt visual.
FLUX_API_URL=
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_PROMPT_URL=http://host.docker.internal:8188/prompt
COMFYUI_WORKFLOW_JSON=

POSTGRES_DB=ritm_ia
POSTGRES_USER=ritm_ia
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ritm_ia:change-me@db:5432/ritm_ia
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_SECONDS=300
SERVER_PORT=8000
